# ObjectScale PoC environment — copy to .env (chmod 600, gitignored)
# NEVER commit .env or any *credentials* file.

# --- ObjectScale endpoints ---
OBS_HOST=192.168.1.31
OBS_MGMT=https://192.168.1.31:4443
OBS_S3_ENDPOINT=https://192.168.1.31:9021
# TableHead over TLS (19021). Plain HTTP is http://<host>:19020 — avoid.
OBS_TABLES_ENDPOINT=https://192.168.1.31:19021
OBS_REGION=us-east-1
OBS_NAMESPACE=poc

# --- S3 Tables / Iceberg ---
ICEBERG_SIGNING_NAME=s3tables
# table bucket NAME; the ARN / Iceberg warehouse is derived from it
TABLE_BUCKET=poc-lakehouse

# --- Buckets ---
BUCKET_DATA=poc-spark-data
BUCKET_THROTTLE=poc-throttle

# --- IAM keys (filled by scripts/prep_obs.py -> /root/.poc/credentials) ---
POC_ADMIN_AK=
POC_ADMIN_SK=
NOISY_AK=
NOISY_SK=
CRITICAL_AK=
CRITICAL_SK=
TABLES_RW_AK=
TABLES_RW_SK=
TABLES_RO_AK=
TABLES_RO_SK=

# --- PoC controls ---
DEMO_SCALE_GB=1
# Critical GET offer rate for notebook 02 (req/s). Lower = less client CPU;
# the phase is INCONCLUSIVE if the client misses >1% of paced slots.
# CRITICAL_RATE=100
# Optional queue-cost probe: QUEUE_TEST=1 adds an enforced-24 phase (24 noisy
# threads) after recovery to compare critical p95 vs the 6-thread enforced phase.
# QUEUE_TEST=0
# optional fixed run id (default: demo-<timestamp>, persisted in reports/current_run_id)
# RUN_ID=demo-customerA
SPARK_MASTER=spark://192.168.1.40:7077
SPARK_UI=http://192.168.1.40:8080

# --- Optional remote noisy-PUT host (U02) ---
# Empty = noisy PUTs run inside U01's LoadGen (local mode, default).
# Set to the agent address to move ONLY tenant-noisy PUTs to the second host;
# critical GETs, phases, verdicts and the chart stay on U01.
# NOISY_HOST=192.168.1.41:8765
# Shared token required by poc/noisy_agent.py (same value on U01 and U02;
# put it in .env on U01 and the 0600 agent env file on U02).
# NOISY_AGENT_TOKEN=
# Agent-side settings (used by noisy-agent.service on U02):
# NOISY_AGENT_BIND=192.168.1.41
# NOISY_AGENT_PORT=8765
# NOISY_AGENT_IDLE_S=60

# Flexible checksums workaround (set to "when_required" if OBS rejects SDK v2 checksums)
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
