# Spark 4.2 PoC — cluster-wide defaults, rendered by scripts/render_conf.py.
#
# Only settings that belong to the cluster as a whole live here (master,
# event log / history server, SQL defaults, secret redaction). Everything
# that is per session — S3A options, the Iceberg `os` catalog and above all
# the credentials — is set by poc/spark_helpers.build_session(), the single
# source of truth for session configuration. This file therefore contains
# no secrets. (When a secret placeholder is added here, render_conf.py
# refuses to render it empty and writes the result with mode 0600.)

spark.master                     {{SPARK_MASTER}}
spark.eventLog.enabled           true
spark.eventLog.dir               file:///var/log/spark-events
spark.history.fs.logDirectory    file:///var/log/spark-events
spark.history.ui.port            18080
spark.sql.adaptive.enabled       true
spark.serializer                 org.apache.spark.serializer.KryoSerializer
# mask credentials (incl. '...access-key-id') in the UI and event log
spark.redaction.regex            (?i)secret|password|token|access[._-]?key
